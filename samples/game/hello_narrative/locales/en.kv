# =============================================================================
# CHROMODYNAMIC - samples/game/hello_narrative/locales/en.kv
# Phase 505 (G4.4 - closes Phase G4). English (en) locale table.
#
# Wired into the sample's L10nManager via StringTable::load(). Plural keys
# use the CLDR v45 "en" rule (one / other) -- see cd::game::l10n header.
#
# Format note: cd::game::l10n trims whitespace around the KEY but takes the
# value VERBATIM after the first '='. Lines below therefore use `key=value`
# with no surrounding spaces so the printed strings are clean.
# =============================================================================

# ---- Dialogue: NPC greeting node -------------------------------------------
intro.speaker=Villager
intro.text=Hello, I have a quest for you. Will you accept?
intro.choice.yes=Yes, I will help.
intro.choice.no=No, not now.

# ---- Dialogue: accepted-quest end node -------------------------------------
accept.speaker=Villager
accept.text=Wonderful! Bring me three apples from the orchard.

# ---- Dialogue: declined-quest end node -------------------------------------
decline.speaker=Villager
decline.text=Maybe next time, traveller.

# ---- Quest journal copy ----------------------------------------------------
quest.title=Find 3 apples
quest.description=The villager needs three ripe apples from the orchard.
quest.reward=A loaf of fresh bread.

# ---- Objective: pluralised "apples remaining" status -----------------------
# Used by L10nManager::get_plural(key, n). English needs {one, other}.
apples.one={n} apple remaining
apples.other={n} apples remaining

# ---- Quest status banner ---------------------------------------------------
quest.status.active=Active
quest.status.completed=Completed
quest.status.failed=Failed
quest.status.inactive=Inactive
