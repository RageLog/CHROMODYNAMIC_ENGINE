# =============================================================================
# CHROMODYNAMIC - samples/game/hello_narrative/locales/ja.kv
# Phase 510 (G4.4 follow-up). Japanese (ja) locale table; replaced the
# Arabic (ar) table per user request — "japonca ve japon harfleriyle olsun".
#
# Japanese is LTR (cd::game::l10n::is_rtl("ja") -> false). CLDR plural rule
# for "ja" is "other only" (no count-based plural distinction), so we ship
# a single `apples.other` form. Numerals stay as digits because Japanese
# typography conventionally uses Arabic numerals for counts in modern
# writing (the kanji 一 / 二 / 三 form is used for ceremonial / archaic
# contexts, not running game text).
#
# Format note: cd::game::l10n trims whitespace around the KEY but takes
# the value VERBATIM after the first '='. UTF-8 source encoding throughout.
# =============================================================================

# ---- Dialogue: NPC greeting node -------------------------------------------
intro.speaker=村人
intro.text=こんにちは、あなたにクエストがあります。受けますか？
intro.choice.yes=はい、お手伝いします。
intro.choice.no=いいえ、今は無理です。

# ---- Dialogue: accepted-quest end node -------------------------------------
accept.speaker=村人
accept.text=ありがとうございます！果樹園からりんごを3個持ってきてください。

# ---- Dialogue: declined-quest end node -------------------------------------
decline.speaker=村人
decline.text=また今度、旅人さん。

# ---- Quest journal copy ----------------------------------------------------
quest.title=りんごを3個探す
quest.description=村人は果樹園から熟したりんごを3個必要としています。
quest.reward=焼きたてのパン一本。

# ---- Objective: pluralised "apples remaining" status -----------------------
# Japanese plural rule = "other only"; cd::game::l10n falls back to
# `apples.other` for every n.
apples.other=残りりんご{n}個

# ---- Quest status banner ---------------------------------------------------
quest.status.active=進行中
quest.status.completed=完了
quest.status.failed=失敗
quest.status.inactive=未開始
