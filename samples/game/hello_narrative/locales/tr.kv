# =============================================================================
# CHROMODYNAMIC - samples/game/hello_narrative/locales/tr.kv
# Phase 505 (G4.4 - closes Phase G4). Turkish (tr) locale table.
#
# Turkish has a single CLDR plural category (other); the noun "elma" carries
# plural marking via the -ler/-lar suffix at the noun level, so the rendered
# string is identical for n=1 and n>1. See cd::game::l10n plural_rule_tr.
#
# Format: `key=value` with no surrounding spaces (the loader is verbatim on
# the value side -- see en.kv header for the rationale).
# =============================================================================

# ---- Dialogue: NPC greeting node -------------------------------------------
intro.speaker=Koylu
intro.text=Merhaba, sana bir gorevim var. Kabul eder misin?
intro.choice.yes=Evet, yardim edecegim.
intro.choice.no=Hayir, simdi olmaz.

# ---- Dialogue: accepted-quest end node -------------------------------------
accept.speaker=Koylu
accept.text=Harika! Bahceden uc elma getir bana.

# ---- Dialogue: declined-quest end node -------------------------------------
decline.speaker=Koylu
decline.text=Bir dahaki sefere belki, yolcu.

# ---- Quest journal copy ----------------------------------------------------
quest.title=3 elma bul
quest.description=Koylu bahceden uc olgun elma istiyor.
quest.reward=Bir somun taze ekmek.

# ---- Objective: pluralised "apples remaining" status -----------------------
# Turkish CLDR has only "other" -- we leave it as the single plural form.
apples.other={n} elma kaldi

# ---- Quest status banner ---------------------------------------------------
quest.status.active=Aktif
quest.status.completed=Tamamlandi
quest.status.failed=Basarisiz
quest.status.inactive=Beklemede
