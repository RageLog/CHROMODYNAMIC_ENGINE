# .clangd — language server config (CHROMODYNAMIC)
#
# AUTO-GENERATED by CMakeModules/Clangd.cmake from .clangd.in. Edit the
# .in template, not this file — the next `cmake --preset ...` overwrites it.
# .clangd is git-ignored; .clangd.in is the tracked source-of-truth.
#
# Why the template:
#   * clangd's compiler-driver convention diverges between MSVC presets
#     (need clang-cl + /std:c++NN) and Unix-style toolchains (clang++/g++
#     + -std=c++NN). Hard-coding either breaks the other.
#   * FetchContent _deps roots live under the active preset's build dir.
#     Switching presets changes the path; configure-time substitution
#     keeps clangd pointed at the right one.
#
# Token substitutions (@VAR@) injected by Clangd.cmake:
#   @CD_CLANGD_COMPILER_LINE@  "  Compiler: <driver>" or empty
#   @CD_CLANGD_STDFLAG@        /std:c++23 or -std=c++23 per active driver
#   @CD_CLANGD_BUILD_DIR@      absolute path to current build/<preset>/
#
# If clangd shows phantom errors the real build doesn't:
#   1. Close the editor.
#   2. rm -rf %LOCALAPPDATA%\clangd\index  (Windows) or  ~/.cache/clangd
#   3. Re-open. clangd re-indexes from compile_commands.json.

CompileFlags:
  # Source-root compile_commands.json takes priority. CompileDatabase.cmake
  # copies the freshest one here on every configure.
  CompilationDatabase: .
@CD_CLANGD_COMPILER_LINE@

  # Fallback flags applied when no DB entry exists for a TU (header files,
  # samples WIP, files outside the build). Mirror cd_add_library so headers
  # consumed across libraries still find their cousins.
  Add:
    - @CD_CLANGD_STDFLAG@
    - -xc++
    - -DCD_DISABLE_VCPKG=1
    - -DVK_NO_PROTOTYPES
    - -DVK_USE_PLATFORM_WIN32_KHR
    - -DWIN32_LEAN_AND_MEAN
    - -DNOMINMAX
    - -Wno-c++17-extensions
    - -Wno-unused-parameter
    - -Wno-unused-variable
    - -ferror-limit=0
    # Foundation tier
    - -Iengine/foundation/core/include
    - -Iengine/foundation/math/include
    - -Iengine/foundation/mem/include
    - -Iengine/foundation/concurrency/include
    - -Iengine/foundation/time/include
    - -Iengine/foundation/io/include
    - -Iengine/foundation/log/include
    - -Iengine/foundation/events/include
    - -Iengine/foundation/diag/include
    - -Iengine/foundation/platform/include
    - -Iengine/foundation/plugin/include
    - -Iengine/foundation/config/include
    - -Iengine/foundation/vfs/include
    # Asset tier
    - -Iengine/asset/include
    # Render tier
    - -Iengine/render/rhi/include
    - -Iengine/render/rhi_vulkan/include
    - -Iengine/render/rhi_vulkan/src
    - -Iengine/render/shader/include
    - -Iengine/render/material/include
    - -Iengine/render/render/include
    - -Iengine/render/framegraph/include
    # World tier
    - -Iengine/world/ecs/include
    - -Iengine/world/scene/include
    - -Iengine/world/physics/include
    - -Iengine/world/anim/include
    - -Iengine/world/audio/include
    - -Iengine/world/input/include
    - -Iengine/world/net/include
    # UI tier
    - -Iengine/ui/ui/include
    - -Iengine/ui/editor_ui/include
    - -Iengine/ui/editor/include
    # Runtime tier
    - -Iengine/runtime/include
    # Fetched dependencies (Vulkan / VMA / glslang headers). Build dir is
    # substituted per-preset by Clangd.cmake so switching from ninja-debug
    # to ninja-release does not break header resolution.
    - -isystem@CD_CLANGD_BUILD_DIR@/_deps/volk-src
    - -isystem@CD_CLANGD_BUILD_DIR@/_deps/vulkan_headers-src/include
    - -isystem@CD_CLANGD_BUILD_DIR@/_deps/vma-src/include
    - -isystem@CD_CLANGD_BUILD_DIR@/_deps/glslang-src
    - -isystem@CD_CLANGD_BUILD_DIR@/_deps/googletest-src/googletest/include

  Remove:
    # Strip MSVC-only and clang-internal flags that clangd does not parse
    # cleanly. `/...` covers cl-style flags; the rest are clang-specific
    # plumbing that confuses the language server when read from the DB.
    - /*
    - -Zc:*
    - -external:*
    - -Xclang
    - --dependent-lib=*
    - -gcodeview

Diagnostics:
  # Hard rule: clangd MUST NOT produce errors/warnings the real compilers
  # don't. Anything that fires only because clangd guessed wrong flags on
  # a header (no DB entry) or stale-indexed an old version of the file is
  # suppressed unconditionally. The real build (ninja/msbuild) is the
  # source of truth for diagnostics; clangd is here for navigation and
  # symbol lookup only.
  UnusedIncludes: None
  MissingIncludes: None
  Suppress:
    # include-cleaner noise — fires on every transitive std:: header
    - missing-includes
    - unused-includes
    # "header not found" — happens for headers whose owning .cpp is not
    # yet in compile_commands.json (newly-added sample / library file);
    # the real compiler resolves them via the fallback include roots
    # added in CompileFlags.Add.
    - pp_file_not_found
    # Phantom parse errors that bubble out of "In included file:" when
    # clangd picks the wrong proxy TU for a header. These were the source
    # of the "is not a structure or union" / "constexpr requires const
    # init" / "use of undeclared identifier 'cd'" red waves.
    - typecheck_member_reference_struct_union
    - typecheck_nonviable_condition
    - typecheck_call_too_few_args
    - typecheck_invalid_operands
    - constexpr_var_requires_const_init
    - constexpr_invalid_function
    - undeclared_var_use
    - undeclared_var_use_suggest
    - unknown_typename
    - unknown_typename_suggest
    - no_member
    - no_member_template
    - no_member_template_suggest
    - typename_nested_not_found
    - expected_class_name
    - expected_unqualified_id
    - incomplete_base_class
    - incomplete_nested_name_spec
    - override_keyword_only_allowed_on_virtual_member_functions
    - override_keyword_hides_virtual_member_function
    - field_incomplete_or_sizeless
    - invalid_token_after_toplevel_declarator
    - ovl_no_viable_conversion_in_cast
    - ovl_no_viable_function_in_call
    - ovl_no_viable_function_in_init
    - init_conversion_failed
    - missing_type_specifier
    - expected_expression
    - template_kw_missing
    - redefinition
    - ext_plain_complex
    - ignored-attributes
    - macro-redefined
  ClangTidy:
    # Keep clang-tidy lean. The CI clang-tidy pass uses its own
    # .clang-tidy file in the repo root; the IDE-side checks here are
    # just the few rules whose hints we want surfaced as you type.
    Add:
      - modernize-use-nullptr
      - modernize-use-override
    Remove:
      - modernize-use-trailing-return-type
      - readability-magic-numbers
      - readability-function-cognitive-complexity
      - bugprone-easily-swappable-parameters
      - bugprone-branch-clone
      - bugprone-unused-return-value
      - bugprone-macro-parentheses
      - performance-enum-size
      - performance-no-int-to-ptr
      - performance-unnecessary-value-param
      - readability-identifier-naming

InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes

Hover:
  ShowAKA: Yes

Index:
  Background: Build
  StandardLibrary: Yes

# ---------------------------------------------------------------------------
# Per-file overrides
# ---------------------------------------------------------------------------
# Headers are the worst phantom-error source: clangd has no compile-commands
# entry for a .hpp and falls back to a "best guess" TU that may have totally
# different include paths. Disable ALL diagnostics inside headers — the
# real .cpp build catches anything that matters. Navigation / Hover /
# Completion all keep working.
---
If:
  PathMatch: [.*\.hpp, .*\.h]
Diagnostics:
  Suppress: ['*']
