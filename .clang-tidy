# =============================================================================
# CHROMODYNAMIC — .clang-tidy
#
# Engine-wide static-analysis configuration. Goals:
#   1. Catch obvious defects (memory leaks, undefined-behavior patterns,
#      bugprone use of strings, swappable params) early in the dev loop.
#   2. Enforce modernization to C++23 idioms (override, nullptr, =default,
#      ranges, span) without nagging on areas where we deliberately diverge
#      (trailing-return-type, magic numbers in shaders).
#   3. Stay zero-noise on third-party code — only files inside engine/ and
#      samples/ are analysed via the CI `clang-tidy` job (HeaderFilterRegex
#      below). FetchContent_'d sources never trigger.
#
# Local usage:
#   clang-tidy -p build/ninja-base engine/<lib>/src/Foo.cpp
# CI usage:
#   The `clang-tidy` job in .github/workflows/ci.yml runs over every TU in
#   compile_commands.json and gates the merge on a clean report.
# =============================================================================
---
# -----------------------------------------------------------------------------
# phase1045 CONFIG-BUG FIX + rationale relocation.
#
# clang-tidy parses the `Checks:` folded scalar as ONE comma-separated
# glob string -- '#' is NOT a comment inside it. The previous config
# carried inline '# ...' notes inside the scalar; every note WITHOUT a
# trailing comma GLUED the next entry into a dead no-op glob. Net
# effect, verified via `clang-tidy --list-checks`: the
# cppcoreguidelines-*, hicpp-*, misc-*, performance-* and
# readability-* family enables were DEAD (glued to the cert-err33-c /
# macro-usage / uppercase-literal-suffix / use-std-print /
# avoid-pragma-once notes respectively), and three trailing disables
# were no-ops. Only bugprone-*, cert-*, modernize-* and portability-*
# were genuinely active. NEVER put '#' text inside Checks.
#
# Disable rationales (moved out of the scalar):
#   -cert-err33-c                    Run12 B1: ignoring printf/scanf/system
#                                    returns is endemic in sample bring-up.
#   -cppcoreguidelines-avoid-do-while Run12 B1: legitimate idiom (retry
#                                    loops, scoped guards).
#   -cppcoreguidelines-macro-to-enum / -modernize-macro-to-enum
#                                    phase1046: same surface as macro-usage —
#                                    CD_HAS_* / CD_PLATFORM_* feature macros
#                                    live in #if/#ifdef contexts where an enum
#                                    is impossible by construction.
#   -cppcoreguidelines-macro-usage   Run13 B1: 294 instances, 292 are
#                                    token-paste/#ifdef platform macros where
#                                    constexpr is impossible; remaining 2 are
#                                    operator-generator macros.
#   -hicpp-uppercase-literal-suffix  Run12 B1: lowercase suffixes (1u, 1.0f)
#                                    are the project convention; mirrors the
#                                    readability- twin below.
#   -modernize-use-std-print         <print> not universally available
#                                    across the compiler matrix yet.
#   -portability-avoid-pragma-once   #pragma once project-wide (CLAUDE.md).
#   -readability-redundant-member-init explicit-init documents intent.
#   -readability-braces-around-statements Run12 B1: single-statement
#                                    if/else is hot-path convention.
#   -readability-suspicious-call-argument Run12 B1: FP-prone on math arg
#                                    shuffles reusing x/y/z names.
#   bugprone-unchecked-optional-access  phase1105: stays at WARNING level.
#                                    The two LIBRARY sites (HandleStore) were
#                                    hardened in phase1103; the ~176 remaining
#                                    diagnostics are gtest code where the
#                                    value is guarded by ASSERT_TRUE(
#                                    has_value()) that the check's flow
#                                    analysis cannot see into. Promote if the
#                                    check ever gains assertion awareness.
#   readability-identifier-naming    phase1107: active but NOT in WAE. The
#                                    dedicated probe found 326 unique sites
#                                    (109 method case / 64 constexpr k-prefix /
#                                    56 variable / 49 private-member suffix /
#                                    22 macro prefix / rest small) AND two
#                                    deliberate convention conflicts the
#                                    config cannot express: cd::math constants
#                                    mirror std::numbers names (pi_v, tau_v)
#                                    and the Jolt adapter mirrors Jolt's API
#                                    casing. Resolving config-vs-code is a
#                                    user decision (plan doc K7); method
#                                    renames are also cross-TU API changes.
#   -readability-use-concise-preprocessor-directives phase1100: wants the
#                                    C++23 #elifdef/#elifndef spellings. 10k+
#                                    hits, zero defect value, and the planned
#                                    compiler matrix (MSVC+Clang-cl+Clang+GCC,
#                                    CLAUDE.md §6) makes the universally-
#                                    supported `#elif defined(...)` the safer
#                                    project convention.
#   -readability-math-missing-parentheses phase1046d: `a + b * c` is the
#                                    standard idiom in a graphics engine;
#                                    the rule fired on ~20 correct sites in
#                                    the first revived sweep alone and
#                                    catches no real defect class for us.
#   google/fuchsia/llvm/zircon       enabled EXPLICITLY (no family globs).
#     phase1067-1070 resolved the 12 deferred siblings:
#     PROMOTED (sites fixed tree-wide, see phase1067/1068/1069):
#       google-build-using-namespace, google-default-arguments,
#       google-explicit-constructor, google-runtime-int,
#       llvm-namespace-comment.
#     STAY OFF by design (probe counts from research/reports/probe12_*):
#       fuchsia-overloaded-operator        3.5k+ sites; operator overloading
#                                          is idiomatic in a math-heavy engine.
#       fuchsia-default-arguments-calls /  6.4k+ sites; default arguments are
#       fuchsia-default-arguments-declarations  project convention. The actual
#                                          bug-class subset (defaults on
#                                          VIRTUALS) is covered by the promoted
#                                          google-default-arguments.
#       fuchsia-trailing-return            trailing-return allowed where it
#                                          helps (mirrors the
#                                          modernize-use-trailing-return-type
#                                          disable in the other direction).
#       fuchsia-statically-constructed-objects  gtest TEST() registrars are
#                                          static ctors by construction.
#       llvm-header-guard                  #pragma once project-wide
#                                          (CLAUDE.md; mirrors
#                                          portability-avoid-pragma-once).
#       llvm-include-order                 include order is owned by
#                                          clang-format IncludeCategories.
# -----------------------------------------------------------------------------
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-branch-clone,
  -bugprone-unused-return-value,
  -bugprone-macro-parentheses,
  -bugprone-narrowing-conversions,
  -bugprone-exception-escape,
  cert-*,
  -cert-err58-cpp,
  -cert-msc51-cpp,
  -cert-msc32-c,
  -cert-err33-c,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-type-union-access,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-init-variables,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-special-member-functions,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-rvalue-reference-param-not-moved,
  -cppcoreguidelines-missing-std-forward,
  -cppcoreguidelines-narrowing-conversions,
  -cppcoreguidelines-avoid-c-arrays,
  -cppcoreguidelines-macro-usage,
  -cppcoreguidelines-macro-to-enum,
  hicpp-*,
  -hicpp-avoid-c-arrays,
  -hicpp-no-array-decay,
  -hicpp-signed-bitwise,
  -hicpp-special-member-functions,
  -hicpp-named-parameter,
  -hicpp-vararg,
  -hicpp-uppercase-literal-suffix,
  -hicpp-braces-around-statements,
  -hicpp-explicit-conversions,
  misc-*,
  -misc-non-private-member-variables-in-classes,
  -misc-include-cleaner,
  -misc-no-recursion,
  -misc-use-anonymous-namespace,
  -misc-const-correctness,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-use-nodiscard,
  -modernize-avoid-c-arrays,
  -modernize-pass-by-value,
  -modernize-use-designated-initializers,
  -modernize-use-std-print,
  -modernize-macro-to-enum,
  performance-*,
  -performance-enum-size,
  -performance-no-int-to-ptr,
  -performance-unnecessary-value-param,
  -performance-avoid-endl,
  portability-*,
  -portability-avoid-pragma-once,
  readability-*,
  -readability-use-concise-preprocessor-directives,
  -readability-magic-numbers,
  -readability-function-cognitive-complexity,
  -readability-function-size,
  -readability-identifier-length,
  -readability-named-parameter,
  -readability-redundant-access-specifiers,
  -readability-uppercase-literal-suffix,
  -readability-implicit-bool-conversion,
  -readability-else-after-return,
  -readability-convert-member-functions-to-static,
  -readability-static-accessed-through-instance,
  -readability-make-member-function-const,
  -readability-qualified-auto,
  -readability-redundant-inline-specifier,
  -readability-redundant-member-init,
  -readability-braces-around-statements,
  -readability-suspicious-call-argument,
  -readability-math-missing-parentheses,
  google-build-explicit-make-pair,
  google-build-namespaces,
  google-build-using-namespace,
  google-default-arguments,
  google-explicit-constructor,
  google-global-names-in-headers,
  google-runtime-int,
  google-runtime-operator,
  google-upgrade-googletest-case,
  fuchsia-header-anon-namespaces,
  fuchsia-multiple-inheritance,
  fuchsia-virtual-inheritance,
  llvm-namespace-comment,
  llvm-prefer-isa-or-dyn-cast-in-conditionals,
  llvm-twine-local,
  zircon-temporary-objects

# Warnings stay warnings locally. CI promotes to errors via -warnings-as-errors.
# Marathon Run 11 phase B4: promote the FULLY-cleaned rules to error status. Bug-class
# rules (bugprone-misplaced-widening-cast / implicit-widening-of-multiplication-result /
# integer-division / suspicious-stringview-data-usage / unhandled-exception-at-new,
# readability-misleading-indentation, cert-flp30-c) stay as warnings until Run 12 lands
# the site-by-site fixes; promotion to error happens then. See
# docs/CLANG_TIDY_AUDIT_RUN11.md for the full rule audit + verdict matrix.
# Run 12 phase B1+B3: all bug-class rules now fully cleaned site-by-site
# in main.cpp + the engine/ tree are promoted to errors so they cannot
# regress. The site fixes landed in this same commit (see fix list in the
# commit message).
# Run 25 phase 928: nine additional bug-class rules probed across the
# engine + samples tree returned zero diagnostics under the existing
# tree; promoted to WarningsAsErrors so future regressions land as
# compile-time failures rather than silent warnings:
#   * bugprone-use-after-move
#   * bugprone-dangling-handle
#   * bugprone-string-constructor
#   * bugprone-suspicious-memset-usage
#   * bugprone-undelegated-constructor
#   * bugprone-throw-keyword-missing
#   * bugprone-not-null-terminated-result
#   * cppcoreguidelines-slicing
#   * cppcoreguidelines-pro-type-static-cast-downcast
# Run 25 phase 936: eleven more bug-class rules probed against the
# engine + samples tree returned zero diagnostics under the existing
# tree; promoted:
#   * bugprone-empty-catch                    (silent catch(...) swallow defence)
#   * bugprone-signal-handler                 (async-unsafe call inside handler)
#   * bugprone-bool-pointer-implicit-conversion
#   * bugprone-multiple-statement-macro
#   * bugprone-sizeof-container               (sizeof(std::vector) is rarely meant)
#   * bugprone-sizeof-expression
#   * bugprone-string-literal-with-embedded-nul
#   * bugprone-suspicious-include
#   * bugprone-suspicious-missing-comma
#   * bugprone-suspicious-semicolon
#   * cert-msc50-cpp                          (rand() weak; use <random> family)
#   * cert-msc30-c                            (same surface, C dialect)
# Run 25 phase 940: eleven additional performance + misc + readability
# rules probed -- ZERO diagnostics across the engine + samples tree:
#   * performance-faster-string-find
#   * performance-for-range-copy
#   * performance-inefficient-vector-operation
#   * performance-trivially-destructible
#   * performance-type-promotion-in-math-fn
#   * misc-misplaced-const
#   * misc-misleading-bidirectional
#   * misc-static-assert
#   * readability-redundant-string-init
#   * readability-string-compare
#   * readability-redundant-string-cstr
# performance-noexcept-move-constructor (7 sites) +
# performance-move-const-arg (2 sites) +
# performance-unnecessary-copy-initialization (~10 sites in
# lighting_clusters and restir_di) deliberately skipped this round
# until site-by-site fixes land.
# Run 25 phase 941: site-by-site fixes for the three skipped rules
# above have landed. ShaderCache + Squad + DialogTreeRuntime +
# DialogueVM + QuestLog + Settings + TriggerWorld now declare
# explicit noexcept move ctor / op=. Dialogue.hpp get_string's
# move-into-ternary collapsed-to-const-ref is split into an
# if-branch so the move actually fires on the fallback path.
# VirtualCamera.cpp drops the no-op std::move on a trivially-copyable
# vcam. DispatchPass.cpp + Denoiser.cpp tighten 15 const-by-value
# error copies to const-ref.
# Run 25 phase 943: thirteen modernize rules promoted -- all zero
# diagnostics after a site-by-site sweep:
#   modernize-deprecated-headers
#   modernize-redundant-void-arg
#   modernize-replace-auto-ptr
#   modernize-replace-disallow-copy-and-assign-macro
#   modernize-replace-random-shuffle
#   modernize-shrink-to-fit
#   modernize-unary-static-assert
#   modernize-use-bool-literals
#   modernize-use-emplace (after fixing ObjLoader / Pathfinding /
#                          CutsceneJson / D3D12Device / MemoryCache)
#   modernize-use-equals-default
#   modernize-use-equals-delete
#   modernize-use-nullptr
#   modernize-use-override
#   modernize-use-using
WarningsAsErrors: 'modernize-use-scoped-lock,bugprone-misplaced-widening-cast,bugprone-implicit-widening-of-multiplication-result,bugprone-integer-division,readability-misleading-indentation,bugprone-suspicious-stringview-data-usage,bugprone-unhandled-exception-at-new,cert-flp30-c,cppcoreguidelines-prefer-member-initializer,bugprone-use-after-move,bugprone-dangling-handle,bugprone-string-constructor,bugprone-suspicious-memset-usage,bugprone-undelegated-constructor,bugprone-throw-keyword-missing,bugprone-not-null-terminated-result,cppcoreguidelines-slicing,cppcoreguidelines-pro-type-static-cast-downcast,bugprone-empty-catch,bugprone-signal-handler,bugprone-bool-pointer-implicit-conversion,bugprone-multiple-statement-macro,bugprone-sizeof-container,bugprone-sizeof-expression,bugprone-string-literal-with-embedded-nul,bugprone-suspicious-include,bugprone-suspicious-missing-comma,bugprone-suspicious-semicolon,cert-msc50-cpp,cert-msc30-c,performance-faster-string-find,performance-for-range-copy,performance-inefficient-vector-operation,performance-trivially-destructible,performance-type-promotion-in-math-fn,misc-misplaced-const,misc-misleading-bidirectional,misc-static-assert,readability-redundant-string-init,readability-string-compare,readability-redundant-string-cstr,performance-noexcept-move-constructor,performance-move-const-arg,performance-unnecessary-copy-initialization,modernize-deprecated-headers,modernize-redundant-void-arg,modernize-replace-auto-ptr,modernize-replace-disallow-copy-and-assign-macro,modernize-replace-random-shuffle,modernize-shrink-to-fit,modernize-unary-static-assert,modernize-use-bool-literals,modernize-use-emplace,modernize-use-equals-default,modernize-use-equals-delete,modernize-use-nullptr,modernize-use-override,modernize-use-using,modernize-pass-by-value,modernize-use-default-member-init,modernize-make-unique,modernize-make-shared,modernize-raw-string-literal,modernize-use-noexcept,readability-container-contains,readability-container-data-poi