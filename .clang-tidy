# =============================================================================
# CHROMODYNAMIC — .clang-tidy
#
# Engine-wide static-analysis configuration. Goals:
#   1. Catch obvious defects (memory leaks, undefined-behavior patterns,
#      bugprone use of strings, swappable params) early in the dev loop.
#   2. Enforce modernization to C++23 idioms (override, nullptr, =default,
#      ranges, span) without nagging on areas where we deliberately diverge
#      (trailing-return-type, magic numbers in shaders).
#   3. Stay zero-noise on third-party code — only files inside engine/ and
#      samples/ are analysed via the CI `clang-tidy` job (HeaderFilterRegex
#      below). FetchContent_'d sources never trigger.
#
# Local usage:
#   clang-tidy -p build/ninja-base engine/<lib>/src/Foo.cpp
# CI usage:
#   The `clang-tidy` job in .github/workflows/ci.yml runs over every TU in
#   compile_commands.json and gates the merge on a clean report.
# =============================================================================
---
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-branch-clone,
  -bugprone-unused-return-value,
  -bugprone-macro-parentheses,
  -bugprone-narrowing-conversions,
  -bugprone-exception-escape,
  cert-*,
  -cert-err58-cpp,
  -cert-msc51-cpp,
  -cert-err33-c,  # Run12 B1: ignoring printf/scanf/system return codes is endemic in sample bring-up; not a real defect class for us.
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-type-union-access,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-init-variables,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-special-member-functions,
  -cppcoreguidelines-avoid-do-while,  # Run12 B1: do-while is a legitimate idiom (e.g. retry loops, scoped guards); rule fires on perfectly correct usage.
  -cppcoreguidelines-rvalue-reference-param-not-moved,
  -cppcoreguidelines-missing-std-forward,
  -cppcoreguidelines-narrowing-conversions,
  -cppcoreguidelines-avoid-c-arrays,
  -cppcoreguidelines-macro-usage,  # Run13 B1: 294 instances total, 292 in Defines.hpp / Definitions.hpp (CD_PLATFORM_*, CD_COMPILER_*, CD_HAS_*, CD_STRINGIFY, CD_CONCAT, CD_UNIQUE_NAME) used in #ifdef / token-pasting / unique-id contexts where constexpr is fundamentally impossible. Remaining 2 (Vector.hpp CD_MATH_VEC_BINOP, Enums.hpp CD_RHI_DEFINE_FLAG_OPS) are textbook operator-generator macros.  # PoD layouts mirror GLSL/Vulkan structs; ADR pending
  hicpp-*,
  -hicpp-avoid-c-arrays,
  -hicpp-no-array-decay,
  -hicpp-signed-bitwise,
  -hicpp-special-member-functions,
  -hicpp-named-parameter,
  -hicpp-vararg,
  -hicpp-uppercase-literal-suffix,  # Run12 B1: style preference; lowercase numeric suffixes (1u, 1.0f) are the project convention. Mirrors -readability-uppercase-literal-suffix below.
  misc-*,
  -misc-non-private-member-variables-in-classes,
  -misc-include-cleaner,
  -misc-no-recursion,
  -misc-use-anonymous-namespace,
  -misc-const-correctness,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-use-nodiscard,
  -modernize-avoid-c-arrays,
  -modernize-pass-by-value,
  -modernize-use-designated-initializers,
  -modernize-use-std-print,  # <print> not universally available across the 8-compiler matrix yet
  performance-*,
  -performance-enum-size,
  -performance-no-int-to-ptr,
  -performance-unnecessary-value-param,
  -performance-avoid-endl,
  portability-*,
  -portability-avoid-pragma-once,  # we use #pragma once project-wide; deliberate per CLAUDE.md
  readability-*,
  -readability-magic-numbers,
  -readability-function-cognitive-complexity,
  -readability-function-size,
  -readability-identifier-length,
  -readability-named-parameter,
  -readability-redundant-access-specifiers,
  -readability-uppercase-literal-suffix,
  -readability-implicit-bool-conversion,
  -readability-else-after-return,
  -readability-convert-member-functions-to-static,
  -readability-static-accessed-through-instance,
  -readability-make-member-function-const,
  -readability-qualified-auto,
  -readability-redundant-inline-specifier,
  -readability-redundant-member-init,  # explicit-init documents intent; less risk on add-field
  -readability-braces-around-statements,  # Run12 B1: single-statement if/else without braces is a project convention in hot-path math + GPU push fill code; rule does not catch real bugs.
  -readability-suspicious-call-argument  # Run12 B1: false-positive prone on math / shader arg shuffles where x/y/z naming reuses parameter names.

# Warnings stay warnings locally. CI promotes to errors via -warnings-as-errors.
# Marathon Run 11 phase B4: promote the FULLY-cleaned rules to error status. Bug-class
# rules (bugprone-misplaced-widening-cast / implicit-widening-of-multiplication-result /
# integer-division / suspicious-stringview-data-usage / unhandled-exception-at-new,
# readability-misleading-indentation, cert-flp30-c) stay as warnings until Run 12 lands
# the site-by-site fixes; promotion to error happens then. See
# docs/CLANG_TIDY_AUDIT_RUN11.md for the full rule audit + verdict matrix.
# Run 12 phase B1+B3: all bug-class rules now fully cleaned site-by-site
# in main.cpp + the engine/ tree are promoted to errors so they cannot
# regress. The site fixes landed in this same commit (see fix list in the
# commit message).
# Run 25 phase 928: nine additional bug-class rules probed across the
# engine + samples tree returned zero diagnostics under the existing
# tree; promoted to WarningsAsErrors so future regressions land as
# compile-time failures rather than silent warnings:
#   * bugprone-use-after-move
#   * bugprone-dangling-handle
#   * bugprone-string-constructor
#   * bugprone-suspicious-memset-usage
#   * bugprone-undelegated-constructor
#   * bugprone-throw-keyword-missing
#   * bugprone-not-null-terminated-result
#   * cppcoreguidelines-slicing
#   * cppcoreguidelines-pro-type-static-cast-downcast
# Run 25 phase 936: eleven more bug-class rules probed against the
# engine + samples tree returned zero diagnostics under the existing
# tree; promoted:
#   * bugprone-empty-catch                    (silent catch(...) swallow defence)
#   * bugprone-signal-handler                 (async-unsafe call inside handler)
#   * bugprone-bool-pointer-implicit-conversion
#   * bugprone-multiple-statement-macro
#   * bugprone-sizeof-container               (sizeof(std::vector) is rarely meant)
#   * bugprone-sizeof-expression
#   * bugprone-string-literal-with-embedded-nul
#   * bugprone-suspicious-include
#   * bugprone-suspicious-missing-comma
#   * bugprone-suspicious-semicolon
#   * cert-msc50-cpp                          (rand() weak; use <random> family)
#   * cert-msc30-c                            (same surface, C dialect)
# Run 25 phase 940: eleven additional performance + misc + readability
# rules probed -- ZERO diagnostics across the engine + samples tree:
#   * performance-faster-string-find
#   * performance-for-range-copy
#   * performance-inefficient-vector-operation
#   * performance-trivially-destructible
#   * performance-type-promotion-in-math-fn
#   * misc-misplaced-const
#   * misc-misleading-bidirectional
#   * misc-static-assert
#   * readability-redundant-string-init
#   * readability-string-compare
#   * readability-redundant-string-cstr
# performance-noexcept-move-constructor (7 sites) +
# performance-move-const-arg (2 sites) +
# performance-unnecessary-copy-initialization (~10 sites in
# lighting_clusters and restir_di) deliberately skipped this round
# until site-by-site fixes land.
# Run 25 phase 941: site-by-site fixes for the three skipped rules
# above have landed. ShaderCache + Squad + DialogTreeRuntime +
# DialogueVM + QuestLog + Settings + TriggerWorld now declare
# explicit noexcept move ctor / op=. Dialogue.hpp get_string's
# move-into-ternary collapsed-to-const-ref is split into an
# if-branch so the move actually fires on the fallback path.
# VirtualCamera.cpp drops the no-op std::move on a trivially-copyable
# vcam. DispatchPass.cpp + Denoiser.cpp tighten 15 const-by-value
# error copies to const-ref.
# Run 25 phase 943: thirteen modernize rules promoted -- all zero
# diagnostics after a site-by-site sweep:
#   modernize-deprecated-headers
#   modernize-redundant-void-arg
#   modernize-replace-auto-ptr
#   modernize-replace-disallow-copy-and-assign-macro
#   modernize-replace-random-shuffle
#   modernize-shrink-to-fit
#   modernize-unary-static-assert
#   modernize-use-bool-literals
#   modernize-use-emplace (after fixing ObjLoader / Pathfinding /
#                          CutsceneJson / D3D12Device / MemoryCache)
#   modernize-use-equals-default
#   modernize-use-equals-delete
#   modernize-use-nullptr
#   modernize-use-override
#   modernize-use-using
WarningsAsErrors: 'modernize-use-scoped-lock,bugprone-misplaced-widening-cast,bugprone-implicit-widening-of-multiplication-result,bugprone-integer-division,readability-misleading-indentation,bugprone-suspicious-stringview-data-usage,bugprone-unhandled-exception-at-new,cert-flp30-c,cppcoreguidelines-prefer-member-initializer,bugprone-use-after-move,bugprone-dangling-handle,bugprone-string-constructor,bugprone-suspicious-memset-usage,bugprone-undelegated-constructor,bugprone-throw-keyword-missing,bugprone-not-null-terminated-result,cppcoreguidelines-slicing,cppcoreguidelines-pro-type-static-cast-downcast,bugprone-empty-catch,bugprone-signal-handler,bugprone-bool-pointer-implicit-conversion,bugprone-multiple-statement-macro,bugprone-sizeof-container,bugprone-sizeof-expression,bugprone-string-literal-with-embedded-nul,bugprone-suspicious-include,bugprone-suspicious-missing-comma,bugprone-suspicious-semicolon,cert-msc50-cpp,cert-msc30-c,performance-faster-string-find,performance-for-range-copy,performance-inefficient-vector-operation,performance-trivially-destructible,performance-type-promotion-in-math-fn,misc-misplaced-const,misc-misleading-bidirectional,misc-static-assert,readability-redundant-string-init,readability-string-compare,readability-redundant-string-cstr,performance-noexcept-move-constructor,performance-move-const-arg,performance-unnecessary-copy-initialization,modernize-deprecated-headers,modernize-redundant-void-arg,modernize-replace-auto-ptr,modernize-replace-disallow-copy-and-assign-macro,modernize-replace-random-shuffle,modernize-shrink-to-fit,modernize-unary-static-assert,modernize-use-bool-literals,modernize-use-emplace,modernize-use-equals-default,modernize-use-equals-delete,modernize-use-nullptr,modernize-use-override,modernize-use-using,modernize-pass-by-value,modernize-use-default-member-init,modernize-make-unique,modernize-make-shared,modernize-raw-string-literal,modernize-use-noexcept,readability-container-contains,readability-container-data-pointer,readability-redundant-control-flow,readability-redundant-smartptr-get,bugprone-assert-side-effect,bugprone-fold-init-type,bugprone-inaccurate-erase,readability-redundant-declaration,modernize-return-braced-init-list,modernize-loop-convert,cppcoreguidelines-explicit-virtual-functions,cppcoreguidelines-interfaces-global-init,cppcoreguidelines-misleading-capture-default-by-value,cppcoreguidelines-pro-type-member-init,cppcoreguidelines-virtual-class-destructor,hicpp-deprecated-headers,hicpp-noexcept-move,portability-restrict-system-includes,portability-simd-intrinsics,portability-std-allocator-const,misc-definitions-in-headers,misc-header-include-cycle,misc-redundant-expression,misc-throw-by-value-catch-by-reference,misc-unconventional-assign-operator,misc-unused-alias-decls,misc-unused-parameters,misc-unused-using-decls,readability-avoid-const-params-in-decls,readability-const-return-type,readability-delete-null-pointer,readability-deleted-default,readability-duplicate-include,readability-misplaced-array-index,readability-non-const-parameter,readability-operators-representation,readability-reference-to-constructed-temporary,readability-simplify-boolean-expr,readability-simplify-subscript-expr,readability-static-definition-in-anonymous-namespace,concurrency-thread-canceltype-asynchronous,bugprone-virtual-near-miss,bugprone-too-small-loop-variable,bugprone-terminating-continue,bugprone-suspicious-string-compare,bugprone-suspicious-realloc-usage,bugprone-suspicious-enum-usage,bugprone-string-integer-assignment,bugprone-spuriously-wake-up-functions,bugprone-reserved-identifier,bugprone-redundant-branch-condition,bugprone-posix-return,bugprone-pointer-arithmetic-on-polymorphic-object,bugprone-parent-virtual-call,bugprone-no-escape,bugprone-multi-level-implicit-pointer-conversion,bugprone-misplaced-pointer-arithmetic-in-alloc,bugprone-misplaced-operator-in-strlen-in-alloc'

# Analyse only OUR code. Engine + samples; never third-party headers via
# FetchContent (those live under build/*/_deps/) and never legacy code
# under _legacy/.
HeaderFilterRegex: '.*[\\/](engine|samples)[\\/].*\.(hpp|h)$'

# clang-tidy's identifier-style check is opinionated and noisy; we configure
# only the project-wide conventions and leave the rest to clang-format.
CheckOptions:
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
  - key: readability-identifier-naming.EnumConstantPrefix
    value: k
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.MethodCase
    value: lower_case
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.MemberCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: _
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.ConstexprVariableCase
    value: CamelCase
  - key: readability-identifier-naming.ConstexprVariablePrefix
    value: k
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE
  - key: readability-identifier-naming.MacroDefinitionPrefix
    value: CD_
  - key: cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor
    value: true
  - key: cppcoreguidelines-special-member-functions.AllowMissingMoveFunctions
    value: true
...
