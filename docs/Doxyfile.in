# =============================================================================
# CHROMODYNAMIC Engine — Doxyfile template
# This file is configured at CMake time. Variables in @VAR@ form are expanded
# by configure_file(); do not edit those by hand.
# =============================================================================

PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "Cross-platform, cross-API hybrid 2D+3D engine + framework"
PROJECT_LOGO           =

OUTPUT_DIRECTORY       = "@CD_DOXYGEN_OUTPUT_DIR@"
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = "@CD_DOXYGEN_MAINPAGE@"

# --- Input ------------------------------------------------------------------
# CD_DOXYGEN_INPUT is expanded by CMake into per-path quoted strings, e.g.
#   INPUT = "C:/path A" "C:/path B"
# Do NOT wrap @CD_DOXYGEN_INPUT@ in additional quotes here.
INPUT                  = @CD_DOXYGEN_INPUT@
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.cpp *.hpp *.h *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */build/* \
                         */.git/* \
                         */.vscode/* \
                         */.cache/* \
                         */tests/* \
                         */_deps/* \
                         */Dependencies/* \
                         */_legacy/* \
                         */research/library/*
EXCLUDE_SYMBOLS        =
STRIP_FROM_PATH        = "@CMAKE_SOURCE_DIR@"
STRIP_FROM_INC_PATH    = "@CMAKE_SOURCE_DIR@"

# --- Source browser ---------------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
VERBATIM_HEADERS       = YES

# --- Extract policy ---------------------------------------------------------
# We want the *public surface* to be the primary view. Private/internal
# symbols still get rendered if explicitly documented, but they don't
# pollute the global namespace pages.
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_PACKAGE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = NO
EXTRACT_LOCAL_METHODS  = NO
EXTRACT_ANON_NSPACES   = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = YES
HIDE_IN_BODY_DOCS      = NO
INTERNAL_DOCS          = NO
CASE_SENSE_NAMES       = YES
HIDE_SCOPE_NAMES       = NO
SHOW_INCLUDE_FILES     = YES
SHOW_GROUPED_MEMB_INC  = NO
FORCE_LOCAL_INCLUDES   = NO
INLINE_INFO            = YES
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = NO
SORT_GROUP_NAMES       = NO
SORT_BY_SCOPE_NAME     = NO
STRICT_PROTO_MATCHING  = NO

# --- Diagnostics ------------------------------------------------------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
# WARN_IF_DOC_ERROR mostly catches cross-file `\ref` failures into markdown
# files we deliberately exclude (narrative docs/PLAN.md, the ADR set). The
# rendered HTML still has those as plain text — readers can navigate the
# repo on GitHub. Logging would be noise; keep it off.
WARN_IF_DOC_ERROR      = NO
WARN_NO_PARAMDOC       = NO
# Gate: any warning Doxygen does emit (e.g. obsolete tag in this file)
# fails the build. We made the input set conservative above so this
# stays clean on PRs.
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_FORMAT            = "$file:$line: $text"
WARN_LOGFILE           = "@CD_DOXYGEN_OUTPUT_DIR@/warnings.log"

# --- Preprocessing ----------------------------------------------------------
# The engine uses CHROMA_<LIB>_API export macros + [[nodiscard]] / [[likely]]
# attributes that confuse Doxygen if it tries to expand them. Strip them.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SEARCH_INCLUDES        = YES
INCLUDE_PATH           =
PREDEFINED             = CD_FOUNDATION_API= \
                         CHROMA_API= \
                         "[[nodiscard]]=" \
                         "[[likely]]=" \
                         "[[unlikely]]=" \
                         "[[maybe_unused]]=" \
                         "[[no_unique_address]]=" \
                         "noexcept=" \
                         "DOXYGEN=1"

# --- C++ language features --------------------------------------------------
EXTENSION_MAPPING      =
TYPEDEF_HIDES_STRUCT   = NO
LOOKUP_CACHE_SIZE      = 0
NUM_PROC_THREADS       = 0
BUILTIN_STL_SUPPORT    = YES
CPP_CLI_SUPPORT        = NO
SIP_SUPPORT            = NO
IDL_PROPERTY_SUPPORT   = NO
DISTRIBUTE_GROUP_DOC   = NO
GROUP_NESTED_COMPOUNDS = NO
SUBGROUPING            = YES
INLINE_GROUPED_CLASSES = NO
INLINE_SIMPLE_STRUCTS  = NO

# --- HTML output ------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_HEADER            =
HTML_FOOTER            =
HTML_STYLESHEET        =
HTML_EXTRA_STYLESHEET  =
HTML_COLORSTYLE        = AUTO_LIGHT
HTML_COLORSTYLE_HUE    = 220
HTML_COLORSTYLE_SAT    = 100
HTML_COLORSTYLE_GAMMA  = 80
HTML_DYNAMIC_MENUS     = YES
HTML_DYNAMIC_SECTIONS  = YES
HTML_INDEX_NUM_ENTRIES = 100
GENERATE_DOCSET        = NO
GENERATE_HTMLHELP      = NO
GENERATE_QHP           = NO
GENERATE_ECLIPSEHELP   = NO
DISABLE_INDEX          = NO
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = NO
ENUM_VALUES_PER_LINE   = 4
TREEVIEW_WIDTH         = 250
EXT_LINKS_IN_WINDOW    = NO
HTML_FORMULA_FORMAT    = png
FORMULA_FONTSIZE       = 10
USE_MATHJAX            = NO
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO
EXTERNAL_SEARCH        = NO

# --- LaTeX / RTF / man / XML ------------------------------------------------
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO
GENERATE_AUTOGEN_DEF   = NO
GENERATE_SQLITE3       = NO
GENERATE_PERLMOD       = NO

# --- Diagrams ---------------------------------------------------------------
# Cheap inheritance/collab graphs only — Graphviz `dot` not assumed
# installed everywhere (CI image will pull it; local dev keeps it
# optional).
HAVE_DOT               = @CD_DOXYGEN_HAVE_DOT@
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = NO
GROUP_GRAPHS           = YES
UML_LOOK               = NO
UML_LIMIT_NUM_FIELDS   = 10
DOT_UML_DETAILS        = NO
DOT_WRAP_THRESHOLD     = 17
TEMPLATE_RELATIONS     = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES
DIR_GRAPH_MAX_DEPTH    = 1
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = NO
DOT_PATH               =
DOTFILE_DIRS           =
DOT_GRAPH_MAX_NODES    = 50
MAX_DOT_GRAPH_DEPTH    = 2
DOT_MULTI_TARGETS      = NO
GENERATE_LEGEND        = YES
DOT_CLEANUP            = YES

# --- Alphabetical class index ----------------------------------------------
ALPHABETICAL_INDEX     = YES
IGNORE_PREFIX          =

# --- Custom aliases for the engine ------------------------------------------
# Used in headers as `/// \cdlibrary{foundation}` etc. Cheap discoverability
# tag for the public-surface index.
ALIASES                = "cdlibrary{1}=\par Library: cd::\1\n" \
                         "cdsubsystem{1}=\par Subsystem: \1\n" \
                         "cdrouting=\par Routing: this symbol is on a hot path"
