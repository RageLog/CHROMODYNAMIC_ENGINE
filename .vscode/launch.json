{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CHROMODYNAMIC Studio (Ninja Debug)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/ninja-base/bin/Debug/editor.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "CHROMODYNAMIC Studio (Ninja Release - Ultra FPS)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/ninja-base/bin/Release/editor.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "CHROMODYNAMIC Studio — Stage 6.3 Rockstar Physics Arena",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/ninja-base/bin/Release/editor.exe",
      "args": ["--studio-level", "15"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug current target (CMake Tools)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
